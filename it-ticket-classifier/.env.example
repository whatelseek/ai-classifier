OPENAI_API_KEY=
# Set for Spark/vLLM via Envoy (uses Chat Completions; key can be any non-empty value)
OPENAI_BASE_URL=
OPENAI_TEXT_MODEL=gpt-4.1-mini
OPENAI_VISION_MODEL=gpt-4.1-mini
OPENAI_TIMEOUT_SECONDS=60
OPENAI_MAX_RETRIES=2
OPENAI_MAX_INPUT_TOKENS=12000
OPENAI_MAX_OUTPUT_TOKENS=128
CLASSIFICATION_SCORING_ONLY=true
MAX_CLASSIFICATION_RETRIES=0
CLASSIFY_EXTRACT_REQUEST_BODY=true
CLASSIFY_DESCRIPTION_ONLY=true
# Joey (decision model) answers only through System One. Used when OPENAI_TEXT_MODEL contains "joey".
# Self-hosted qev server on Spark (no key): http://10.70.0.121:8003/v1/systemone with JOEY_DECISION_MODEL=joey-1
# Baseten: https://inference.baseten.co/v1/systemone with BASETEN_API_KEY and
#          JOEY_DECISION_MODEL=decision-models/baseten-joey-2b-latest
JOEY_ROUTING_MODE=auto
JOEY_SYSTEMONE_URL=
BASETEN_API_KEY=
JOEY_DECISION_MODEL=joey-1

MAX_FILE_SIZE_BYTES=20971520
MAX_ATTACHMENTS=10
MAX_TOTAL_UPLOAD_BYTES=52428800
REQUEST_TIMEOUT_SECONDS=180
MAX_CLASSIFICATION_RETRIES=2
MAX_CONCURRENT_REQUESTS=10
MAX_CONCURRENT_EXTRACTION=4

LOG_LEVEL=INFO
LOG_JSON=true
MASK_INTERNAL_HOSTS=true
TEMP_DIR=/tmp/it-ticket-classifier
# Remote Docling on Spark (omit to run Docling in-process; requires pip install .[docling])
DOCLING_API_URL=
DOCLING_TIMEOUT_SECONDS=120